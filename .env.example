# Copy this file to .env.local and fill in real values.
# Never commit .env.local — only this template is tracked.
#
# Generate a secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Required: signs session JWTs.
JWT_SECRET=replace-with-64-hex-characters

# Optional: encrypts stored SMTP passwords. Falls back to JWT_SECRET when unset.
SMTP_PASSWORD_ENCRYPTION_KEY=replace-with-64-hex-characters

# Required for the staff face check: encrypts the stored staff face photos.
# At least 32 characters; without it face enrollment and check-in return 503.
# STAFF_IDENTITY_ENCRYPTION_KEY=replace-with-at-least-32-characters

# Required for the staff face check: Face++ API credentials (server-side only).
# Without both values the face check is disabled and staff cannot check in.
# FACEPP_API_KEY=
# FACEPP_API_SECRET=
# Optional: Face++ region, one of US (default), CN, SG.
# FACEPP_API_REGION=US

# Optional locally. When set, the app uses this hosted PostgreSQL database
# instead of PGlite. On Vercel this must be configured in Project Settings.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require

# Optional: absolute path to the PGlite data directory.
# Defaults to ./data/merrylane-pglite
# MERRYLANE_DB_DIR=

# Xendit GCash checkout (server-side only; never expose these in client code).
# Non-production always uses the test key; production always uses the live key.
# XENDIT_TEST_SECRET_KEY=
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
# Use a public HTTPS origin in production. Local test demos may use localhost.
# APP_URL=https://your-public-domain.example
# APP_URL=http://localhost:3112

# Optional: stable base address encoded into table QR codes. Leave unset to use
# the admin page's current network address (auto-detected when opened on
# localhost). Set it to a hostname or public domain so a saved or printed QR
# keeps working when the computer's Wi-Fi address changes.
# QR_BASE_URL=https://merrylane.example
# QR_BASE_URL=http://merrylane.local:3112

# Copy this file to .env.local and fill in real values.
# Never commit .env.local — only this template is tracked.
#
# Generate a secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Required: signs session JWTs.
JWT_SECRET=replace-with-64-hex-characters

# Optional: encrypts stored SMTP passwords. Falls back to JWT_SECRET when unset.
SMTP_PASSWORD_ENCRYPTION_KEY=replace-with-64-hex-characters

# Optional: absolute path to the PGlite data directory.
# Defaults to ./data/merrylane-pglite
# MERRYLANE_DB_DIR=

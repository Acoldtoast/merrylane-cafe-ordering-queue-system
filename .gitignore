# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================================
# SECRETS — never commit (highest priority)
# ============================================================
# Environment files (real values). Keep local only.
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# ...but a scrubbed template is safe to commit.
!.env.example
!.env.sample
!.env.migrate.example

# Keys, certificates, signing material
/certificates/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
*.mobileprovision
*.asc
id_rsa*
id_ed25519*
id_ecdsa*

# Service account / cloud CLI credentials
*service-account*.json
*credentials*.json
.gcloud/
.aws/
.azure/
.kube/
.docker/config.json
.npmrc
.pypirc
.netrc

# ============================================================
# LOCAL DATABASE & RUNTIME DATA (customer PII)
# ============================================================
# PGlite cluster, snapshots, backups, restore scratch dirs.
# Contains customer records, password hashes, payment proofs.
/data/
# Explicit catches in case /data is ever partially un-ignored
/data/**/*.db
/data/**/*.db-shm
/data/**/*.db-wal
/data/**/*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.db-journal
*.dump
*.backup

# Database exports must go outside the repo, but just in case
/backups/
/backup/
/exports/
/dumps/

# ============================================================
# DEPENDENCIES
# ============================================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/my-app/node_modules

# ============================================================
# BUILD OUTPUT / GENERATED CODE
# ============================================================
/.next/
/.next-production/
/out/
/build
/dist/
*.tsbuildinfo
next-env.d.ts
/coverage
/graphify-out/

# ============================================================
# LOGS & DEBUG ARTIFACTS
# ============================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/
/logs/
/log.txt
# Ad-hoc scratch scripts, not part of the app
/scripts/_*.cjs
/git_restored.tsx
/original_backup.tsx
/original_staffidentity.tsx
/public/tmp-qr-decode.png

# ============================================================
# OS / EDITOR / MACHINE-SPECIFIC
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.lnk
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ============================================================
# DEPLOY / TOOLING METADATA
# ============================================================
.vercel
.turbo
.cache/
/.freebuff/
/eslintcache
